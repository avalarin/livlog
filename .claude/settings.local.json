{
  "permissions": {
    "allow": [
      "Bash(swiftlint:*)",
      "Bash(xcodebuild:*)",
      "Bash(go mod tidy:*)",
      "Bash(golangci-lint run:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(go test:*)",
      "Bash(go mod download:*)",
      "Bash(go get:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(just:*)",
      "mcp__xcodebuildmcp__*",
      "Bash(xcrun simctl:*)",
      "Bash(git diff:*)",
      "Bash(git rebase:*)",
      "WebSearch",
      "Bash(git:*)",
      "Bash(gh run:*)",
      "Bash(bash .claude/skills/worktree-init/scripts/init-worktree.sh collection-stats-screen)",
      "Bash(CLAUDE_PROJECT_DIR=/Users/avprokopev/Projects/livlogios /Users/avprokopev/Projects/livlogios/.claude/hooks/update-status.sh)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/track-modified-files.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/update-status.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/trigger-code-review.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/update-status.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/update-status.sh"
          }
        ]
      }
    ]
  },
  "outputStyle": "default"
}
